# Track configuration explicitly; ignore runtime data and credentials by default.
/*
!/.gitignore
!/README.md
!/skill-snapshots/
!/agent/
/agent/*
!/agent/settings.json
!/agent/extensions/
!/agent/themes/
!/agent/skills/

# Never commit credentials, environment files, or dependencies.
**/auth.json
**/.env
**/.env.*
**/node_modules/
**/*.pem
**/*.key
